# Set these on your hosting provider, NOT in the public website.
OPENAI_API_KEY=replace_with_your_secret_key
OPENAI_MODEL=gpt-4o-mini

# Optional inbound AI phone agent via a Twilio voice-enabled number.
# This does NOT automatically connect the user's personal WhatsApp/mobile number.
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_WEBHOOK_BASE_URL=https://your-actual-domain.com
